diff --git a/BepInEx/Compat/LegacyPlatform.cs b/BepInEx/Compat/LegacyPlatform.cs
new file mode 100644
index 0000000..dd6117d
--- /dev/null
+++ b/BepInEx/Compat/LegacyPlatform.cs
@@ -0,0 +1,55 @@
+using System;
+
+// MonoMod 25 dropped Platform and PlatformHelper. BepInEx 5 still asks for
+// them all over, so this puts the old enum and check back under the old
+// names. the preloader fills in Current itself (Platform.cs SetPlatform)
+namespace MonoMod.Utils
+{
+	[Flags]
+	public enum Platform
+	{
+		Unknown = 0,
+		OS = 1 << 0,
+		Bits64 = 1 << 1,
+		NT = 1 << 2,
+		Unix = 1 << 3,
+		ARM = 1 << 16,
+		Wine = 1 << 17,
+		Windows = OS | NT | 1 << 5,
+		MacOS = OS | Unix | 1 << 6,
+		Linux = OS | Unix | 1 << 7,
+		Android = Linux | 1 << 8,
+		iOS = MacOS | 1 << 9,
+	}
+
+	public static class PlatformHelper
+	{
+		static Platform? current;
+
+		public static Platform Current
+		{
+			get
+			{
+				if (current == null)
+					current = Guess();
+				return current.Value;
+			}
+			set { current = value; }
+		}
+
+		public static bool Is(Platform p) { return (Current & p) == p; }
+
+		// only used if something asks before the preloader sets it
+		static Platform Guess()
+		{
+			var p = IntPtr.Size >= 8 ? Platform.Bits64 : 0;
+			switch (Environment.OSVersion.Platform)
+			{
+				case PlatformID.Win32NT: return p | Platform.Windows;
+				case PlatformID.MacOSX: return p | Platform.MacOS;
+				case PlatformID.Unix: return p | Platform.Linux;
+				default: return p;
+			}
+		}
+	}
+}
